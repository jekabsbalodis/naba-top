NABA_TOP_DATA_DIR=/var/lib/naba-top      # holds the DuckDB file (stage/ only for manual runs)
NABA_TOP_DB_PATH=naba.duckdb             # relative to NABA_TOP_DATA_DIR
NABA_TOP_URL=https://example.com/top
NABA_TOP_EMAIL=you@example.com           # goes into the User-Agent header

S3_KEY_ID=
S3_SECRET=
S3_ENDPOINT=
S3_REGION=

NTFY_URL=                                # optional, used by the DAG failure handler
